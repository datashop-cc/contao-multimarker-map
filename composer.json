{
    "name": "datashop/contao-multimarker-map",
    "type": "contao-bundle",
    "description": "Contao Content Element: Karte (OpenStreetMap/Leaflet oder Google Maps) mit mehreren Markern, Tooltips und Routing-Link zu Google/Apple Maps",
    "keywords": ["contao", "leaflet", "openstreetmap", "google-maps", "content-element", "map"],
    "homepage": "https://github.com/datashop-cc/contao-multimarker-map",
    "license": "MIT",
    "authors": [
        { "name": "Datashop Riedel KG", "homepage": "https://www.datashop.cc" }
    ],
    "support": {
        "issues": "https://github.com/datashop-cc/contao-multimarker-map/issues",
        "source": "https://github.com/datashop-cc/contao-multimarker-map"
    },
    "require": {
        "php": "^8.2",
        "contao/core-bundle": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "Datashop\\MultiMarkerMap\\": "src/"
        }
    },
    "conflict": {
        "contao/core": "*"
    },
    "extra": {
        "contao-manager-plugin": "Datashop\\MultiMarkerMap\\ContaoManager\\Plugin"
    }
}

